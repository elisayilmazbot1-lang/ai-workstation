{
  "name": "ai-workstation",
  "productName": "AI Workstation",
  "version": "1.0.0",
  "description": "AI Workstation — çoklu model ve çoklu ajan destekli masaüstü yapay zekâ geliştirme istasyonu",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "sqlite",
    "ai",
    "agents",
    "llm",
    "desktop",
    "turkce"
  ],
  "main": "out/main/index.js",
  "author": "AI Workstation",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/elisayilmazbot1-lang/ai-workstation.git"
  },
  "bugs": {
    "url": "https://github.com/elisayilmazbot1-lang/ai-workstation/issues"
  },
  "homepage": "https://github.com/elisayilmazbot1-lang/ai-workstation#readme",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "vite",
    "dev:backend": "tsx backend/server/standalone.ts",
    "native": "node scripts/fix-native-win.mjs",
    "native:electron": "node scripts/fix-native-win.mjs electron",
    "dev:electron": "node scripts/fix-native-win.mjs electron && node scripts/dev-electron.mjs",
    "build": "vite build",
    "build:electron": "electron-vite build",
    "build:all": "node scripts/build-all.mjs",
    "package:win": "node scripts/build-all.mjs --package",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/fix-native-win.mjs && vitest run",
    "test:watch": "vitest",
    "smoke": "tsx scripts/smoke.ts",
    "mock": "tsx scripts/mock-provider.ts",
    "release": "node scripts/prepare-release.mjs",
    "monaco": "node scripts/copy-monaco.mjs",
    "kur": "npm ci --ignore-scripts && node scripts/fix-native-win.mjs && node scripts/install-electron.mjs && node scripts/copy-monaco.mjs",
    "verify": "node scripts/fix-native-win.mjs && node scripts/verify-release.mjs",
    "e2e": "node scripts/fix-native-win.mjs && node scripts/e2e-scenario.mjs",
    "check:spec": "node scripts/check-spec-consistency.mjs",
    "check:all": "node scripts/verify-release.mjs",
    "build:win": "node scripts/fix-native-win.mjs electron && node scripts/prepare-native-win.mjs && node scripts/build-all.mjs && npx electron-builder --win nsis portable --x64",
    "prepare:native:win": "node scripts/prepare-native-win.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "better-sqlite3": "12.11.1",
    "diff": "^7.0.0",
    "dockerode": "^4.0.2",
    "fastify": "^5.1.0",
    "fflate": "^0.8.2",
    "nanoid": "^5.0.7",
    "playwright-core": "^1.48.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/diff": "^6.0.0",
    "@types/dockerode": "^3.3.31",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.24.0",
    "lucide-react": "^0.452.0",
    "monaco-editor": "^0.52.0",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3",
    "zustand": "^5.0.0"
  }
}
